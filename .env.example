# Create a bot using @BotFather. Never commit or share this token.
TELEGRAM_BOT_TOKEN=
# Only this private chat may control the bot or receive reports.
TELEGRAM_CHAT_ID=
# Cloudflare custom API token: Account > Radar > Read
CLOUDFLARE_API_TOKEN=
# Check every 5 minutes; source data is aggregated into 15-minute buckets.
POLL_SECONDS=300
DATA_DIR=data
