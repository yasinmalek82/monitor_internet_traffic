[Unit]
Description=Iran Internet Monitor - private Persian Telegram alerts
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=iran-monitor
Group=iran-monitor
WorkingDirectory=/opt/iran-internet-monitor/current
ExecStart=/opt/iran-internet-monitor/current/.venv/bin/python -m iran_monitor --env /etc/iran-internet-monitor/monitor.env run
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
KillMode=control-group
UMask=0077
Environment=DATA_DIR=/var/lib/iran-internet-monitor
Environment=MPLCONFIGDIR=/var/cache/iran-internet-monitor/matplotlib
Environment=XDG_CACHE_HOME=/var/cache/iran-internet-monitor
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
StateDirectory=iran-internet-monitor
StateDirectoryMode=0700
CacheDirectory=iran-internet-monitor
CacheDirectoryMode=0700
MemoryAccounting=true
MemoryHigh=128M
MemoryMax=256M
CPUAccounting=true
CPUQuota=20%
CPUWeight=10
Nice=10
IOSchedulingClass=idle
TasksMax=32
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LogRateLimitIntervalSec=60s
LogRateLimitBurst=5

[Install]
WantedBy=multi-user.target
